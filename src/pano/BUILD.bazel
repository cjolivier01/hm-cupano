    ],
    copts = [
      "--std=c++17",
    ],
    defines = ROCM_HIP_DEFINES,
    include_prefix = INCLUDE_PREFIX,
    visibility = ["//visibility:public"],
    deps = [
        ":blend_mode",
        ":cv_types",
        ":canvas_manager",
        ":canvas",
        ":cuda_matrix",
        ":feather_mask",
        "//src/cuda:cuda_blend_cuda_lib_headers",
        "@opencv_linux//:opencv",
