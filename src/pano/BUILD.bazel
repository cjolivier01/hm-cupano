# Generic N-image pano library
cc_library(
    name = "cuda_pano_n",
    hdrs = [
        "blendRoi.h",
        "cudaPanoN.h",
        "cudaPanoN.inl",
        "canvasManagerN.h",
    ],
    copts = [
        "--std=c++17",
    ],
    include_prefix = INCLUDE_PREFIX,
    visibility = ["//visibility:public"],
    deps = (
        [
            ":blend_mode",
            ":cv_types",
            ":canvas",
            ":control_masks_n",
            ":feather_mask",
            "@opencv_linux//:opencv",
        ]
        + select({
            "//:use_hip": ["//src/cuda:cuda_blend_cuda_lib_hip"],
            "//:use_vulkan": ["//src/cuda:cuda_blend_vulkan_lib"],
            "//conditions:default": ["//src/cuda:cuda_blend_cuda_lib"],
        })
    ),
)

# Headers used by HIP genrule to construct a virtual include tree
filegroup(
    name = "pano_public_headers",
    srcs = glob([
        "*.h",
        "*.inl",
    ]),
    visibility = ["//visibility:public"],
)

